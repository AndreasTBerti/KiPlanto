# Configurações de APIs Meteorológicas e Geocodificação
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
GEO_ENCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Histórico diário (reanálise ERA5). Usado para a chuva média mensal dos últimos 12 meses,
# que é a escala de chuva com que o modelo foi treinado.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLIMATE_HTTP_TIMEOUT_SECONDS=10

# Origens liberadas no CORS, separadas por vírgula. Com o proxy do Vite (npm run dev)
# o navegador fala com a mesma origem e o CORS não entra em jogo.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# Notícias de colheita (GET /news) — ver docs/SPEC-noticias-colheita.md §5.7–5.8
# Cache da resposta por cidade/UF/janela/cultura (respostas parciais expiram em até 2 min)
NEWS_CACHE_TTL_SECONDS=1800
# Cache de cada feed RSS baixado (no máximo ~4 downloads/hora por feed por processo)
NEWS_FEED_CACHE_TTL_SECONDS=900
NEWS_HTTP_TIMEOUT_SECONDS=8
# Fontes ativas, separadas por vírgula (vazio = todas)
NEWS_ENABLED_SOURCES=g1_estadual,g1_agro,canal_rural,portal_agronegocio,globo_rural,compre_rural

# Contas e login. Vazio = data/kiplanto.db, na raiz do projeto.
KIPLANTO_DB_PATH=
AUTH_SESSION_DAYS=7

# Leitura das notícias por IA (OpenRouter). Sem chave, o sistema usa só as regras locais.
OPENROUTER_API_KEY=
# Modelos em ordem de preferência, separados por vírgula. Vazio = inception/mercury-2.5,google/gemma-4-26b-a4b-it
OPENROUTER_MODELS=
# Trava de preço, em US$ por milhão de tokens: o próprio OpenRouter recusa o que passar disso.
OPENROUTER_MAX_INPUT_PRICE=0.20
OPENROUTER_MAX_OUTPUT_PRICE=0.50
# Trava de gasto, em US$, por execução do servidor. Ao chegar nela, o sistema volta para as regras locais.
OPENROUTER_MAX_SPEND_USD=1.00
# Prazo de cada etapa (classificar, escrever a conclusão), em segundos
OPENROUTER_TIMEOUT_SECONDS=45
# Por quanto tempo guardar o que a IA respondeu
OPENROUTER_CACHE_TTL_SECONDS=86400
